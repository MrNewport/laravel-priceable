{
    "name": "mrnewport/laravel-priceable",
    "description": "Quantity-based pricing with multi-tenant and multi-scope support for any Eloquent model.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MrNewport",
            "email": "admin@matthewnewport.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "MrNewport\\LaravelPriceable\\": "src/"
        },
        "files": [
            "src/Support/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MrNewport\\LaravelPriceable\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MrNewport\\LaravelPriceable\\Providers\\PriceableServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "pestphp/pest": "^3.7|^4.0",
        "orchestra/testbench": "^9.9|^10.0|^11.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest"
    }
}
